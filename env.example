# ─────────────────────────────────────────────────────────────
# OCAS Discord Sales Bot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!
# ─────────────────────────────────────────────────────────────

# Discord bot token (from discord.dev/applications → your app → Bot → Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Channel ID to post sales in
# Right-click the channel in Discord → Copy Channel ID
# (Developer Mode must be on: Settings → Advanced → Developer Mode)
SALES_CHANNEL_ID=your_channel_id_here

# OpenSea API key (free at opensea.io → Settings → Developer)
# Without this key, the bot will still work but may hit rate limits
OPENSEA_KEY=your_opensea_api_key_here

# How often to poll OpenSea for new sales (milliseconds)
# Default: 30000 (30 seconds). Don't go below 15000.
POLL_MS=30000
