# Discord bot token (discord.dev/applications → Bot → Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord application/client ID (discord.dev/applications → General Information → Application ID)
CLIENT_ID=your_application_id_here

# OpenSea API key (opensea.io → Settings → Developer) — optional but recommended
OPENSEA_KEY=your_opensea_api_key_here

# How often to poll for new sales in milliseconds (default 30000 = 30s)
POLL_MS=30000
